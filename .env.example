# 数据库配置
DB_HOST=192.168.88.188
DB_PORT=5432
DB_NAME=xiaole_ai
DB_USER=your_database_user
DB_PASS=your_database_password

# AI API 配置 (二选一)
# 使用 DeepSeek API (推荐)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash

# LLM governance (non-secret, fail-closed defaults)
LLM_USAGE_DB=/app/logs/llm_usage.sqlite3
LLM_BUDGET_USER_HOUR=30
LLM_BUDGET_USER_DAY=100
LLM_BUDGET_BACKGROUND_HOUR=10
LLM_BUDGET_BACKGROUND_DAY=30
LLM_BUDGET_GLOBAL_HOUR=40
LLM_BUDGET_GLOBAL_DAY=120
LLM_CONTEXT_SYSTEM_TOKENS=8000
LLM_CONTEXT_HISTORY_TOKENS=12000
LLM_CONTEXT_MEMORY_TOKENS=4000
LLM_CONTEXT_TOOL_TOKENS=4000
LLM_CONTEXT_USER_TOKENS=4000
LLM_CONTEXT_TOTAL_TOKENS=24000

# 或使用 Claude API
CLAUDE_API_KEY=your_claude_api_key
USE_CLAUDE=false

# 图片识别配置
QWEN_API_KEY=your_qwen_api_key
QWEN_MODEL=qwen-plus

# XiaoLe 2.0 Core Phase A ports
LEZHI_MEMORY_URL=http://127.0.0.1:8765
LEZHI_MEMORY_TOKEN=
LEZHI_MEMORY_TIMEOUT_SECONDS=20
XIAOKE_ACTION_URL=
XIAOKE_API_TOKEN=replace-with-xiaoke-action-core-token
XIAOKE_ACTION_TIMEOUT_SECONDS=10
# 小乐 2.0 统一提醒复用以上 Action Core URL、Token 和超时配置。
# Token 必须通过生产环境密钥注入，不得写入仓库或前端配置。

# 百度语音配置
BAIDU_APP_ID=your_baidu_app_id
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# 百度人脸识别配置 (可选，用于识别照片中的人物)
BAIDU_FACE_APP_ID=your_baidu_face_app_id
BAIDU_FACE_API_KEY=your_baidu_face_api_key
BAIDU_FACE_SECRET_KEY=your_baidu_face_secret_key

# Webhook 配置
WEBHOOK_SECRET=your_webhook_secret

# 服务配置
HOST=0.0.0.0
PORT=8000
